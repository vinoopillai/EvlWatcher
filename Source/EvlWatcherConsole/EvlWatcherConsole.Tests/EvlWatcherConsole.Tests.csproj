<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EvlWatcherConsole.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EvlWatcherConsole\EvlWatcherConsole.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- the rules the installer ships, so ShippedRulesTests check what users actually get -->
    <None Include="..\..\EvlWatcher\EvlWatcher\config.xml" Link="ShippedConfig\config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>EvlWatcherConsole.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- ThemeResourceTests load the console's App resources -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EvlWatcherConsole\EvlWatcherConsole.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- the console's XAML as text, so ThemeResourceTests can check what the views reference -->
    <None Include="..\EvlWatcherConsole\App.xaml" Link="Xaml\App.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EvlWatcherConsole\View\*.xaml" Link="Xaml\View\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EvlWatcherConsole\Themes\*.xaml" Link="Xaml\Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- the rules the installer ships, so ShippedRulesTests check what users actually get -->
    <None Include="..\..\EvlWatcher\EvlWatcher\config.xml" Link="ShippedConfig\config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

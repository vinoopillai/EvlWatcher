<!--
  Icons as vector outlines on a 16x16 grid, drawn for EvlWatcher. They replace icon-font glyphs
  (Segoe MDL2 Assets / Segoe Fluent Icons), which Windows 7 and 8.1 don't have.
  Each geometry is stroked, not filled: use it through IconPathStyle (a Path) or IconButtonStyle (Tag = geometry).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- tabs -->
    <Geometry x:Key="ShieldIcon">M 8,1.5 L 13.5,3.5 L 13.5,7.5 C 13.5,11 11,13.3 8,14.5 C 5,13.3 2.5,11 2.5,7.5 L 2.5,3.5 Z</Geometry>
    <Geometry x:Key="PulseIcon">M 1.5,8.5 L 4.5,8.5 L 6.5,3.5 L 9.5,12.5 L 11.5,8.5 L 14.5,8.5</Geometry>
    <Geometry x:Key="ListIcon">M 5.5,4 L 14,4 M 5.5,8 L 14,8 M 5.5,12 L 14,12 M 2,4 L 2.5,4 M 2,8 L 2.5,8 M 2,12 L 2.5,12</Geometry>
    <Geometry x:Key="SettingsIcon">M 5.5,8 A 2.5,2.5 0 1 1 10.5,8 A 2.5,2.5 0 1 1 5.5,8 Z M 8,1.5 L 8,3.5 M 8,12.5 L 8,14.5 M 1.5,8 L 3.5,8 M 12.5,8 L 14.5,8 M 3.4,3.4 L 4.8,4.8 M 11.2,11.2 L 12.6,12.6 M 3.4,12.6 L 4.8,11.2 M 11.2,4.8 L 12.6,3.4</Geometry>
    <Geometry x:Key="CodeIcon">M 5.5,4 L 1.5,8 L 5.5,12 M 10.5,4 L 14.5,8 L 10.5,12</Geometry>

    <!-- actions -->
    <Geometry x:Key="EditIcon">M 10.5,2.5 L 13.5,5.5 L 5.5,13.5 L 2,14 L 2.5,10.5 Z M 9,4 L 12,7</Geometry>
    <Geometry x:Key="PlayIcon">M 4.5,2.5 L 13,8 L 4.5,13.5 Z</Geometry>
    <Geometry x:Key="ResetIcon">M 13.5,8 A 5.5,5.5 0 1 1 11.9,4.1 M 12.5,1.5 L 12.5,4.5 L 9.5,4.5</Geometry>
    <Geometry x:Key="AddIcon">M 8,2.5 L 8,13.5 M 2.5,8 L 13.5,8</Geometry>
    <Geometry x:Key="CancelIcon">M 3.5,3.5 L 12.5,12.5 M 12.5,3.5 L 3.5,12.5</Geometry>
    <Geometry x:Key="LockIcon">M 3.5,7.5 L 12.5,7.5 L 12.5,14 L 3.5,14 Z M 5.5,7.5 L 5.5,5 A 2.5,2.5 0 0 1 10.5,5 L 10.5,7.5</Geometry>
    <Geometry x:Key="UnlockIcon">M 3.5,7.5 L 12.5,7.5 L 12.5,14 L 3.5,14 Z M 5.5,7.5 L 5.5,5 A 2.5,2.5 0 0 1 10.3,4</Geometry>

    <!--
      A 16x16 icon. Stretch is None so every icon keeps its size on the shared grid; scale with a LayoutTransform.
      The stroke follows the surrounding control's Foreground, so disabled, selected and accent states colour it too.
    -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>EvlWatcherConsole</RootNamespace>
    <AssemblyName>EvlWatcherConsole</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\EvlWatcher.ico</ApplicationIcon>
    <!-- version and metadata live in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- the UI is English-only; don't ship the WCF packages' localized resource folders -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.NetNamedPipe" Version="10.1.0" />
  </ItemGroup>

  <!--
    The WCF contract is compiled in from source rather than referencing EvlWatcher.WCF.dll,
    which targets .NET Framework 4.7.2. Namespaces are unchanged, so the wire contract
    stays identical to the one the service hosts.
  -->
  <ItemGroup>
    <Compile Include="..\..\EvlWatcher\EvlWatcher.WCF\IEvlWatcherService.cs" Link="Contract\IEvlWatcherService.cs" />
    <Compile Include="..\..\EvlWatcher\EvlWatcher.WCF\DTOs\*.cs" Link="Contract\DTOs\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\EvlWatcher.ico" />
  </ItemGroup>

</Project>

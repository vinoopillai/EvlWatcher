<UserControl x:Class="EvlWatcherConsole.View.NewRuleWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="Step1LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="1">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Step2LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="2">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Step3LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource StepLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step}" Value="3">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Loopback / unspecified candidates stay visible but can't be picked -->
        <Style x:Key="CandidateItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Next is replaced by Save on the last step -->
        <Style x:Key="NextButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelfTestTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelfTestPassed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}" Margin="0">
        <DockPanel>
            <!-- Step indicator -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Step1LabelStyle}" Text="1 Paste" />
                <TextBlock Style="{StaticResource Step2LabelStyle}" Text="2 Pick IP" />
                <TextBlock Style="{StaticResource Step3LabelStyle}" Text="3 Review" />
            </StackPanel>

            <!-- Navigation -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource NextButtonStyle}" />
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Step 1 -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Paste the event" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="In Event Viewer, open the failed-login event, go to Details, XML View, select all and copy." />
                        <TextBox Style="{StaticResource MonoTextBoxStyle}" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MinHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Event XML" />
                        <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding ParseError}" />
                    </StackPanel>

                    <!-- Step 2 -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Pick the attacker's IP" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                                Visibility="{Binding IsCovered, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Already covered by rule" />
                                    <Run FontWeight="SemiBold" Text="{Binding CoveredByRule, Mode=OneWay}" /><Run Text="." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,2,0,8"
                                           Text="An enabled rule already finds an IP in this event." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Continue anyway" Command="{Binding ContinueAnywayCommand}" Margin="0,0,8,0" />
                                    <Button Content="Go to rule" Command="{Binding GoToRuleCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,8"
                                   Visibility="{Binding NoUsableCandidate, Converter={StaticResource BoolToVisibility}}"
                                   Text="EvlWatcher can't build a rule from this event automatically. Use the Advanced tab, or open a GitHub issue with this XML." />

                        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource CandidateItemStyle}"
                                 AutomationProperties.Name="IP addresses found in the event">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Text="{Binding Address, Mode=OneWay}" /><Run Text=", found in " /><Run FontStyle="Italic" Text="{Binding FieldLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintTextStyle}"
                                                   Text="This is your own machine, not an attacker."
                                                   Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Step 3 -->
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Review and save" />

                        <StackPanel DataContext="{Binding Draft}">
                            <TextBlock Text="Name" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rule name" />
                            <TextBlock Text="Description" Margin="0,10,0,4" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     AutomationProperties.Name="Rule description" />

                            <WrapPanel Margin="0,16,0,8">
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="Ban an IP after" />
                                <TextBox Style="{StaticResource NumberBoxStyle}" Text="{Binding AttemptsText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Failed attempts" />
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="failed attempts within" />
                                <TextBox Style="{StaticResource NumberBoxStyle}" Text="{Binding WindowMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Time window in minutes" />
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="minutes." />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="Ban it for" />
                                <TextBox Style="{StaticResource NumberBoxStyle}" Text="{Binding BanMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Ban duration in minutes" />
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="minutes." />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="Ban permanently after" />
                                <TextBox Style="{StaticResource PermanentNumberBoxStyle}" Text="{Binding PermanentAfterText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Temporary bans before a permanent ban" />
                                <TextBlock Style="{StaticResource SentenceTextStyle}" Text="temporary bans." />
                                <CheckBox Content="Never ban permanently" IsChecked="{Binding NeverPermanent}" Margin="16,0,0,0" />
                            </WrapPanel>

                            <Expander Header="Advanced (event log, booster words, regex)" Margin="0,12,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Event logs (one per line)" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource MonoTextBoxStyle}" AcceptsReturn="True" MinHeight="48"
                                             Text="{Binding EventLogsText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Event logs" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,2,0,10"
                                               Text="The log the event came from. It must exist on this machine." />
                                    <TextBlock Text="Booster words (one per line)" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource MonoTextBoxStyle}" AcceptsReturn="True" MinHeight="48"
                                             Text="{Binding BoostersText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Booster words" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,2,0,10"
                                               Text="An event is only checked with the regex when it contains all of these words. This keeps the scan fast." />
                                    <TextBlock Text="Regex" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource MonoTextBoxStyle}" TextWrapping="Wrap"
                                             Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Regex" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,2,0,10"
                                               Text="Must contain exactly one capture group that matches the attacker IP address." />
                                    <CheckBox Content="Only check new events" IsChecked="{Binding OnlyNewEvents}" />
                                </StackPanel>
                            </Expander>

                            <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding FieldError}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SelfTestTextStyle}" Text="{Binding SelfTestMessage}" />
                        <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding SaveError}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

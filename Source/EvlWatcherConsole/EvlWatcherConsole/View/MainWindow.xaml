<Window x:Class="EvlWatcherConsole.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EvlWatcherConsole.ViewModel"
        xmlns:view="clr-namespace:EvlWatcherConsole.View"
        Title="EvlWatcher v3.2.0 Console"
        Height="720" Width="1040" MinHeight="600" MinWidth="880"
        Icon="pack://application:,,,/Resources/EvlWatcher.ico"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource ContentFontFamily}" FontSize="14" UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- "Nothing here yet" overlay on top of an empty list. Bind Tag to the list's Count; shown only when it is 0. -->
        <Style x:Key="EmptyListHintStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Margin="12,8,12,0">

            <!-- ============================================================ -->
            <!-- Bans & whitelist                                              -->
            <!-- ============================================================ -->
            <TabItem IsSelected="{Binding IsIPTabSelected, Mode=OneWayToSource}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource ShieldIcon}" Margin="0,0,8,0" />
                        <TextBlock Text="Bans &amp; Whitelist" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!-- Temporary bans -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Temporarily banned" VerticalAlignment="Center" />
                                <Border Style="{StaticResource CountBadgeStyle}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding TemporarilyBannedIPs.Count, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource HintTextStyle}" Margin="0,4,0,8"
                                       Text="Lifted automatically when the rule's lock time runs out." />
                            <Grid Grid.Row="2">
                                <ListView SelectedItem="{Binding SelectedTemporaryIP}" IsEnabled="{Binding IsServiceResponding}"
                                          ItemsSource="{Binding TemporarilyBannedIPs}" KeyDown="ListViewKeyDown"
                                          AutomationProperties.Name="Temporarily banned IPs" />
                                <TextBlock Style="{StaticResource EmptyListHintStyle}" Tag="{Binding TemporarilyBannedIPs.Count}"
                                           Text="No IPs are temporarily banned right now." />
                            </Grid>
                            <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Margin="0" Content="Ban all permanently"
                                        Command="{Binding MoveAllTemporaryToPermaCommand}" IsEnabled="{Binding CanAddTemporaryToPerma}"
                                        ToolTip="Move every temporarily banned IP to the permanent ban list" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource UnlockIcon}"
                                        Command="{Binding MoveTemporaryToWhiteListCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Whitelist the selected IP" AutomationProperties.Name="Whitelist the selected IP" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource LockIcon}"
                                        Command="{Binding MoveTemporaryToPermaCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Ban the selected IP permanently" AutomationProperties.Name="Ban the selected IP permanently" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource CancelIcon}"
                                        Command="{Binding RemoveTemporaryBanCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Lift the temporary ban for the selected IP" AutomationProperties.Name="Lift temporary ban" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Permanent bans -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Permanently banned" VerticalAlignment="Center" />
                                <Border Style="{StaticResource CountBadgeStyle}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding PermanentlyBannedIPs.Count, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource HintTextStyle}" Margin="0,4,0,8"
                                       Text="Never lifted automatically. Stored in config.xml." />
                            <Grid Grid.Row="2">
                                <ListView SelectedItem="{Binding SelectedPermanentIP}" IsEnabled="{Binding IsServiceResponding}"
                                          ItemsSource="{Binding PermanentlyBannedIPs}" KeyDown="ListViewKeyDown"
                                          AutomationProperties.Name="Permanently banned IPs" />
                                <TextBlock Style="{StaticResource EmptyListHintStyle}" Tag="{Binding PermanentlyBannedIPs.Count}" Text="No permanent bans." />
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PermaBanIPString, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         ToolTip="IP address to ban permanently, e.g. 203.0.113.7" AutomationProperties.Name="IP address to ban" />
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource AddIcon}"
                                        Command="{Binding AddPermaBanCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Ban the entered IP permanently" AutomationProperties.Name="Add permanent ban" />
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource CancelIcon}"
                                        Command="{Binding RemovePermaBanCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Remove the selected IP from the permanent ban list" AutomationProperties.Name="Remove permanent ban" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Whitelist -->
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Whitelist" VerticalAlignment="Center" />
                                <Border Style="{StaticResource CountBadgeStyle}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding WhiteListedPatterns.Count, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource HintTextStyle}" Margin="0,4,0,8"
                                       Text="Matching IPs are never banned. Wildcards allowed, e.g. 192.168.*" />
                            <Grid Grid.Row="2">
                                <ListView x:Name="WhiteList" SelectionMode="Multiple" SelectedItem="{Binding SelectedWhiteListPattern}"
                                          IsEnabled="{Binding IsServiceResponding}" ItemsSource="{Binding WhiteListedPatterns}" KeyDown="ListViewKeyDown"
                                          AutomationProperties.Name="Whitelisted IP patterns" />
                                <TextBlock Style="{StaticResource EmptyListHintStyle}" Tag="{Binding WhiteListedPatterns.Count}" Text="Nothing is whitelisted." />
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding WhiteListFilter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         ToolTip="IP or wildcard pattern to whitelist, e.g. 10.0.0.*" AutomationProperties.Name="Pattern to whitelist" />
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource AddIcon}"
                                        Command="{Binding AddWhiteListFilterCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Add the entered pattern to the whitelist" AutomationProperties.Name="Add to whitelist" />
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{StaticResource CancelIcon}"
                                        Command="{Binding RemoveWhiteListFilterCommand}" IsEnabled="{Binding IsServiceResponding}"
                                        ToolTip="Remove the selected pattern from the whitelist" AutomationProperties.Name="Remove from whitelist" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- Live log                                                      -->
            <!-- ============================================================ -->
            <TabItem IsSelected="{Binding IsConsoleTabSelected, Mode=OneWayToSource}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource PulseIcon}" Margin="0,0,8,0" />
                        <TextBlock Text="Live" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,16,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"
                                   Text="Recent output of the EvlWatcher service." />
                        <CheckBox DockPanel.Dock="Right" x:Name="AutoscrollCheckBox" Content="Auto-scroll" IsChecked="True"
                                  VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ComboBox DockPanel.Dock="Right" x:Name="ComboVerbosity" Width="140" VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailableLogLevels}" SelectedValue="{Binding SelectedConsoleLevel}"
                                  AutomationProperties.Name="Verbosity" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabelStyle}" Text="Verbosity" />
                    </DockPanel>
                    <TextBox Grid.Row="1" Name="ConsoleTextbox" Style="{StaticResource MonoTextBoxStyle}"
                             IsReadOnly="True" Text="{Binding ConsoleText}" TextChanged="ConsoleTextBox_TextChanged"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" AutomationProperties.Name="Service output" />
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- Rules                                                         -->
            <!-- ============================================================ -->
            <TabItem IsSelected="{Binding IsRulesTabSelected, Mode=OneWayToSource}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource ListIcon}" Margin="0,0,8,0" />
                        <TextBlock Text="Rules" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <view:RulesView DataContext="{Binding Rules}" />
            </TabItem>

            <!-- ============================================================ -->
            <!-- Analyzer                                                      -->
            <!-- ============================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource AnalyzeIcon}" Margin="0,0,8,0" />
                        <TextBlock Text="Analyzer" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <view:AnalyzerView DataContext="{Binding Analyzer}" />
            </TabItem>

            <!-- ============================================================ -->
            <!-- Settings                                                      -->
            <!-- ============================================================ -->
            <TabItem IsSelected="{Binding IsGlobalConfigSelected, Mode=OneWayToSource}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource SettingsIcon}" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,12" MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="Log level" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" ItemsSource="{Binding AvailableLogLevels}"
                                          IsEnabled="{Binding IsInGlobalEditMode}" SelectedItem="{Binding LogLevel}"
                                          AutomationProperties.Name="Log level" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource HintTextStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Text="Messages at or above this level are written to the Windows Event Log." />

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="Console backlog" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding ConsoleBackLog}"
                                         IsEnabled="{Binding IsInGlobalEditMode}" AutomationProperties.Name="Console backlog (entries)" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource HintTextStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Text="Entries kept for the Live tab, i.e. how far back you can scroll." />

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Check interval (s)" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding CheckInterval}"
                                         IsEnabled="{Binding IsInGlobalEditMode}" AutomationProperties.Name="Check interval (seconds)" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource HintTextStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Text="How often the event logs are scanned." />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInGlobalEditMode, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Cancel" Command="{Binding CancelGlobalEditingCommand}" ToolTip="Discard changes" MinWidth="96" />
                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveGlobalConfigCommand}"
                                        ToolTip="Apply to the EvlWatcher service" MinWidth="96" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInGlobalEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Command="{Binding ToggleGlobalConfigEditModeCommand}" ToolTip="Start editing the values above" MinWidth="96">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource EditIcon}" LayoutTransform="0.875,0,0,0.875,0,0" Margin="0,0,8,0" />
                                        <TextBlock Text="Edit" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- Advanced (rule tester)                                                  -->
            <!-- ============================================================ -->
            <TabItem IsSelected="{Binding IsRuleEditorTabSelected, Mode=OneWayToSource}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource CodeIcon}" Margin="0,0,8,0" />
                        <TextBlock Text="Advanced" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,16,12">
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"
                                   Text="Check whether a rule would catch a given event-log entry." />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="1. Select a rule" />
                                <ComboBox HorizontalAlignment="Left" Width="320" ItemsSource="{Binding AvailableTaskNames}"
                                          SelectedItem="{Binding SelectedTaskName}" AutomationProperties.Name="Rule" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="Regex" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Style="{StaticResource MonoTextBoxStyle}" IsReadOnly="True"
                                             TextWrapping="Wrap" Text="{Binding CurrentTaskRegex, Mode=OneWay}" AutomationProperties.Name="Rule regex" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="Event path" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Style="{StaticResource MonoTextBoxStyle}" IsReadOnly="True"
                                             TextWrapping="Wrap" Text="{Binding CurrentTaskEventPath, Mode=OneWay}" AutomationProperties.Name="Event path" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Booster words" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Style="{StaticResource MonoTextBoxStyle}" IsReadOnly="True"
                                             TextWrapping="Wrap" Text="{Binding CurrentTaskBoosters, Mode=OneWay}" AutomationProperties.Name="Booster words" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="2. Paste the event's XML" />
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"
                                           Text="In Event Viewer: open the event → Details → XML View, then copy everything." />
                                <TextBox Style="{StaticResource MonoTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                         Text="{Binding XMLText}" Height="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         AutomationProperties.Name="Event XML" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="3. Test the regex" />
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"
                                           Text="Capture group 1 must be the IP. If it doesn't match, tweak the regex and test again — regex101.com helps." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource MonoTextBoxStyle}" Text="{Binding CurrentTestRegex}" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Regex to test" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="96"
                                            Command="{Binding TestRegexCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource PlayIcon}" LayoutTransform="0.875,0,0,0.875,0,0" Margin="0,0,8,0" />
                                            <TextBlock Text="Test" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="96" Command="{Binding ResetRegexCommand}"
                                            ToolTip="Restore the selected rule's regex">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource ResetIcon}" LayoutTransform="0.875,0,0,0.875,0,0" Margin="0,0,8,0" />
                                            <TextBlock Text="Reset" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="4. Share it" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="Found an attack that should be blocked but isn't? You can add or fix a task in config.xml — but please also open a GitHub issue with the XML and regex above, so other users benefit too." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServiceResponding}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="EvlWatcher service is not responding" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServiceResponding}" Value="True">
                                    <Setter Property="Text" Value="EvlWatcher service is running" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>

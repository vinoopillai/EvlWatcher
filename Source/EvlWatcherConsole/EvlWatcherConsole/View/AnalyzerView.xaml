<UserControl x:Class="EvlWatcherConsole.View.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EvlWatcherConsole.View">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:RangeLabelConverter x:Key="RangeLabel" />

        <!-- Coloured pill with the severity ("Critical", "Warning", "Info") -->
        <Style x:Key="SeverityPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityText}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityText}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,16,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Range, Scan, progress, Cancel -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <ComboBox DockPanel.Dock="Left" Width="160" VerticalAlignment="Center"
                      ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                      IsEnabled="{Binding IsScanning, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                      AutomationProperties.Name="Time range to scan">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource RangeLabel}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button DockPanel.Dock="Left" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="96"
                    Command="{Binding ScanCommand}" ToolTip="Scan the event logs for risks">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource AnalyzeIcon}" Margin="0,0,8,0" />
                    <TextBlock Text="Scan" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="80" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource HintTextStyle}" Margin="12,0" VerticalAlignment="Center"
                       Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>

        <!-- Summary -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                        Content="{Binding BanAllLabel}" Command="{Binding BanAllCommand}"
                        Visibility="{Binding HasBanAll, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Add every unbanned attacker found to the permanent ban list" />
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding SummaryText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource ShowWhenTextStyle}" Margin="0,4,0,0" Text="{Binding NoticeText}" />
                    <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding ActionError}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Findings -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Findings}" AutomationProperties.Name="Findings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource SeverityPillStyle}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold" Text="{Binding SeverityText}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"
                                                   Text="{Binding CategoryText}" />
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="Done"
                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                        <Border />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Title}" />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Details}" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" Text="{Binding Advice}" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Actions}"
                                                  Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,0" Content="{Binding Label}" Command="{Binding Command}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding Error}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Margin="16" Text="{Binding EmptyText}" IsHitTestVisible="False">
                <TextBlock.Visibility>
                    <Binding Path="Findings.Count" Converter="{x:Static local:ZeroToVisibleConverter.Instance}" />
                </TextBlock.Visibility>
            </TextBlock>
        </Grid>

        <!-- Logs checked -->
        <TextBlock Grid.Row="3" Style="{StaticResource ShowWhenTextStyle}" Margin="0,8,0,0" Text="{Binding LogsText}" />
    </Grid>
</UserControl>
